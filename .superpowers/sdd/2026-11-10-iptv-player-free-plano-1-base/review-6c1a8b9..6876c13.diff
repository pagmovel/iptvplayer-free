+package io.github.pagmovel.iptvplayer.dados
+
+import androidx.room.Entity
+import androidx.room.PrimaryKey
+
+/** Tipo de conteúdo de uma categoria/canal Xtream. */
+enum class TipoConteudo { AO_VIVO, FILME, SERIE }
+
+/** Categoria do catálogo (ao vivo, filme ou série) de uma conta. */
+@Entity(primaryKeys = ["contaId", "tipo", "categoriaId"])
+data class Categoria(
+    val contaId: Long,
+    val tipo: TipoConteudo,
+    val categoriaId: Long,
+    val nome: String,
+)
+
+/** Canal de TV ao vivo de uma conta. */
+@Entity(primaryKeys = ["contaId", "streamId"])
+data class Canal(
+    val contaId: Long,
+    val streamId: Long,
+    val nome: String,
+    val categoriaId: Long?,
+    val icone: String?,
+    val epgId: String?,
+    val numero: Int?,
+)
+
+/** Filme (VOD) de uma conta. */
+@Entity(primaryKeys = ["contaId", "streamId"])
+data class Filme(
+    val contaId: Long,
+    val streamId: Long,
+    val nome: String,
+    val categoriaId: Long?,
+    val capa: String?,
+    val extensao: String?,
+    val ano: Int?,
+    val nota: Double?,
+    val adicionadoEm: Long?,
+)
+
+/** Série (VOD) de uma conta. */
+@Entity(primaryKeys = ["contaId", "seriesId"])
+data class Serie(
+    val contaId: Long,
+    val seriesId: Long,
+    val nome: String,
+    val categoriaId: Long?,
+    val capa: String?,
+    val sinopse: String?,
+    val ano: Int?,
+    val nota: Double?,
+    val modificadaEm: Long?,
+)
+
+/**
+ * Entrada da programação (EPG) de um canal. A chave composta (contaId, epgId, inicio) já
+ * serve de índice de busca por canal/horário — não precisa de índice extra.
+ */
+@Entity(primaryKeys = ["contaId", "epgId", "inicio"])
+data class Programa(
+    val contaId: Long,
+    val epgId: String,
+    val inicio: Long,
+    val fim: Long,
+    val titulo: String,
+    val descricao: String?,
+)
+
+/** Conta Xtream cadastrada no app. Preenchida pela T10 (ContaDao). */
+@Entity
+data class Conta(
+    @PrimaryKey(autoGenerate = true) val id: Long = 0,
+    val nome: String,
+    val servidor: String,
+    val usuario: String,
+    val senhaCifrada: ByteArray,
+    val ativa: Boolean,
+    val ultimaCargaEm: Long?,
+)
diff --git a/app/src/main/java/io/github/pagmovel/iptvplayer/dados/Fts.kt b/app/src/main/java/io/github/pagmovel/iptvplayer/dados/Fts.kt
new file mode 100644
index 0000000..77fe7fc
--- /dev/null
+++ b/app/src/main/java/io/github/pagmovel/iptvplayer/dados/Fts.kt
@@ -0,0 +1,31 @@
+package io.github.pagmovel.iptvplayer.dados
+
+import androidx.room.Entity
+import androidx.room.Fts4
+import androidx.room.FtsOptions
+
+/**
+ * Índices de busca textual (FTS4) do nome de canais, filmes e séries.
+ *
+ * São "external content tables" do SQLite: a tabela FTS não guarda cópia do texto, só o
+ * índice, e lê o nome direto da entidade de origem (`contentEntity`) pelo rowid implícito
+ * que toda tabela SQLite tem (mesmo com chave primária composta, como aqui). Por isso o
+ * SQLite não atualiza esse índice sozinho quando a entidade de origem muda em massa — é
+ * preciso reconstruí-lo com `INSERT INTO <tabela>(<tabela>) VALUES ('rebuild')`
+ * (https://www.sqlite.org/fts3.html#_external_content_fts4_tables_). É isso que
+ * `CatalogoDao` faz depois de cada inserção/remoção em massa.
+ *
+ * `TOKENIZER_UNICODE61` tokeniza em minúsculas e remove acentos por padrão
+ * (remove_diacritics=1), por isso a busca ignora acento e maiúscula sem configuração extra.
+ */
+@Fts4(contentEntity = Canal::class, tokenizer = FtsOptions.TOKENIZER_UNICODE61)
+@Entity(tableName = "CanalFts")
+data class CanalFts(val nome: String)
+
+@Fts4(contentEntity = Filme::class, tokenizer = FtsOptions.TOKENIZER_UNICODE61)
+@Entity(tableName = "FilmeFts")
+data class FilmeFts(val nome: String)
+
+@Fts4(contentEntity = Serie::class, tokenizer = FtsOptions.TOKENIZER_UNICODE61)
+@Entity(tableName = "SerieFts")
+data class SerieFts(val nome: String)
diff --git a/app/src/test/java/io/github/pagmovel/iptvplayer/dados/CatalogoDaoTest.kt b/app/src/test/java/io/github/pagmovel/iptvplayer/dados/CatalogoDaoTest.kt
